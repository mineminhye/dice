<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>주사위 확률 시뮬레이션</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;700&display=swap');
        body { font-family: 'Noto Sans KR', sans-serif; }
        .chart-container { position: relative; height: 300px; width: 100%; }
    </style>
</head>
<body class="bg-gray-50 min-h-screen p-4 md:p-8">
    <div class="max-w-6xl mx-auto">
        <header class="mb-8 text-center">
            <h1 class="text-3xl font-bold text-gray-800">주사위 확률 시뮬레이션</h1>
            <p class="text-gray-600 mt-2">큰 수의 법칙: 던지는 횟수가 늘어남에 따라 상대도수는 수학적 확률 1/6에 가까워집니다.</p>
        </header>

        <!-- 컨트롤 및 통계 섹션 -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
            <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex flex-col items-center justify-center">
                <div id="die-visual" class="w-24 h-24 bg-blue-600 rounded-2xl shadow-inner flex items-center justify-center mb-6 text-white text-5xl font-bold transition-all duration-150 transform">
                    ?
                </div>
                <div class="flex flex-wrap justify-center gap-2">
                    <button id="btn-roll-1" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition">1회 던지기</button>
                    <button id="btn-roll-100" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-medium transition">100회 던지기</button>
                    <button id="btn-roll-1000" class="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-medium transition">1000회 던지기</button>
                    <button id="btn-reset" class="px-4 py-2 bg-red-100 text-red-600 hover:bg-red-200 rounded-lg font-medium transition">초기화</button>
                </div>
            </div>

            <div class="lg:col-span-2 bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                <h3 class="text-lg font-bold mb-4 text-gray-700">시뮬레이션 통계</h3>
                <div class="grid grid-cols-3 sm:grid-cols-6 gap-4">
                    <div class="text-center">
                        <div class="text-xs text-gray-500 mb-1">총 횟수</div>
                        <div id="total-rolls" class="text-2xl font-bold text-blue-600">0</div>
                    </div>
                    <div class="col-span-5 grid grid-cols-3 sm:grid-cols-6 gap-2">
                        <!-- 눈별 통계가 동적으로 들어갈 자리 -->
                        <div class="bg-gray-50 p-2 rounded">
                            <div class="text-xs text-gray-400">1의 눈</div>
                            <div id="count-1" class="font-bold">0</div>
                            <div id="freq-1" class="text-[10px] text-gray-500">0%</div>
                        </div>
                        <div class="bg-gray-50 p-2 rounded">
                            <div class="text-xs text-gray-400">2의 눈</div>
                            <div id="count-2" class="font-bold">0</div>
                            <div id="freq-2" class="text-[10px] text-gray-500">0%</div>
                        </div>
                        <div class="bg-gray-50 p-2 rounded">
                            <div class="text-xs text-gray-400">3의 눈</div>
                            <div id="count-3" class="font-bold">0</div>
                            <div id="freq-3" class="text-[10px] text-gray-500">0%</div>
                        </div>
                        <div class="bg-gray-50 p-2 rounded">
                            <div class="text-xs text-gray-400">4의 눈</div>
                            <div id="count-4" class="font-bold">0</div>
                            <div id="freq-4" class="text-[10px] text-gray-500">0%</div>
                        </div>
                        <div class="bg-gray-50 p-2 rounded">
                            <div class="text-xs text-gray-400">5의 눈</div>
                            <div id="count-5" class="font-bold">0</div>
                            <div id="freq-5" class="text-[10px] text-gray-500">0%</div>
                        </div>
                        <div class="bg-gray-50 p-2 rounded">
                            <div class="text-xs text-gray-400">6의 눈</div>
                            <div id="count-6" class="font-bold">0</div>
                            <div id="freq-6" class="text-[10px] text-gray-500">0%</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 그래프 섹션 -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                <h3 class="text-lg font-bold mb-4 text-gray-700">주사위 눈의 분포 (도수)</h3>
                <div class="chart-container">
                    <canvas id="barChart"></canvas>
                </div>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                <h3 class="text-lg font-bold mb-4 text-gray-700">상대도수의 수렴 (수학적 확률 1/6)</h3>
                <div class="chart-container">
                    <canvas id="lineChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <script>
        // 상태 변수
        let totalRolls = 0;
        let counts = [0, 0, 0, 0, 0, 0];
        let history = [[], [], [], [], [], []]; // 상대도수 기록 (그래프용)
        let labels = []; // 회차 레이블
        
        const THEORETICAL_PROB = 1/6;

        // 차트 초기화
        const barCtx = document.getElementById('barChart').getContext('2d');
        const barChart = new Chart(barCtx, {
            type: 'bar',
            data: {
                labels: ['1', '2', '3', '4', '5', '6'],
                datasets: [{
                    label: '나온 횟수',
                    data: counts,
                    backgroundColor: 'rgba(59, 130, 246, 0.6)',
                    borderColor: 'rgb(59, 130, 246)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: { y: { beginAtZero: true } }
            }
        });

        const lineCtx = document.getElementById('lineChart').getContext('2d');
        const colors = [
            '#ef4444', '#f59e0b', '#10b981', '#3b82f6', '#6366f1', '#8b5cf6'
        ];
        
        const lineChart = new Chart(lineCtx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    ...[1, 2, 3, 4, 5, 6].map((num, i) => ({
                        label: `${num}의 눈`,
                        data: history[i],
                        borderColor: colors[i],
                        borderWidth: 1.5,
                        pointRadius: 0,
                        fill: false,
                        tension: 0.1
                    })),
                    {
                        label: '이론적 확률 (1/6)',
                        data: [],
                        borderColor: '#1f2937',
                        borderDash: [5, 5],
                        borderWidth: 2,
                        pointRadius: 0,
                        fill: false
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { 
                        min: 0, 
                        max: 0.4,
                        title: { display: true, text: '상대도수' }
                    },
                    x: {
                        title: { display: true, text: '시행 횟수' }
                    }
                },
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { boxWidth: 12, font: { size: 10 } }
                    }
                }
            }
        });

        // 기능 함수
        function rollDie() {
            const result = Math.floor(Math.random() * 6) + 1;
            totalRolls++;
            counts[result - 1]++;
            return result;
        }

        function updateUI(lastResult) {
            // 주사위 시각화 업데이트
            const dieEl = document.getElementById('die-visual');
            if (lastResult) {
                dieEl.innerText = lastResult;
                dieEl.classList.add('scale-110');
                setTimeout(() => dieEl.classList.remove('scale-110'), 150);
            }

            // 통계 텍스트 업데이트
            document.getElementById('total-rolls').innerText = totalRolls.toLocaleString();
            for (let i = 1; i <= 6; i++) {
                const count = counts[i - 1];
                const freq = totalRolls > 0 ? (count / totalRolls * 100).toFixed(1) : 0;
                document.getElementById(`count-${i}`).innerText = count.toLocaleString();
                document.getElementById(`freq-${i}`).innerText = `${freq}%`;
            }

            // 차트 데이터 업데이트
            barChart.data.datasets[0].data = [...counts];
            barChart.update('none');

            // 선그래프는 데이터가 너무 많으면 성능 저하가 있으므로 샘플링
            if (totalRolls % Math.max(1, Math.floor(totalRolls / 100)) === 0 || totalRolls < 100) {
                labels.push(totalRolls);
                for (let i = 0; i < 6; i++) {
                    history[i].push(counts[i] / totalRolls);
                }
                // 이론적 확률선 업데이트
                lineChart.data.datasets[6].data.push(THEORETICAL_PROB);
                
                // 데이터 포인트가 너무 많아지면 앞부분 제거 (성능 유지)
                if (labels.length > 200) {
                    labels.shift();
                    for(let i=0; i<6; i++) history[i].shift();
                    lineChart.data.datasets[6].data.shift();
                }
                
                lineChart.update('none');
            }
        }

        function multiRoll(n) {
            for (let i = 0; i < n; i++) {
                rollDie();
                // 100회 이상의 대량 주사위질 시 매번 UI를 업데이트하면 느려지므로 마지막에만 수행하거나 가끔 수행
                if (n <= 1 || i === n - 1) {
                    updateUI(n === 1 ? counts.indexOf(Math.max(...counts)) + 1 : null); 
                } else if (i % Math.floor(n/10) === 0) {
                    // 중간 업데이트 (애니메이션 효과)
                }
            }
            if (n > 1) updateUI(null);
        }

        // 이벤트 리스너
        document.getElementById('btn-roll-1').addEventListener('click', () => {
            const res = rollDie();
            updateUI(res);
        });

        document.getElementById('btn-roll-100').addEventListener('click', () => multiRoll(100));
        document.getElementById('btn-roll-1000').addEventListener('click', () => multiRoll(1000));

        document.getElementById('btn-reset').addEventListener('click', () => {
            totalRolls = 0;
            counts = [0, 0, 0, 0, 0, 0];
            history = [[], [], [], [], [], []];
            labels = [];
            document.getElementById('die-visual').innerText = '?';
            
            barChart.data.datasets[0].data = counts;
            lineChart.data.labels = labels;
            for(let i=0; i<7; i++) lineChart.data.datasets[i].data = [];
            
            barChart.update();
            lineChart.update();
            updateUI(null);
        });

        // 초기 상태 로드
        updateUI(null);
    </script>
</body>
</html>
